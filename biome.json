{
  "$schema": "https://biomejs.dev/schemas/2.2.5/schema.json",
  "files": {
    "includes": [
      "**/*.{js,jsx,mjs,ts,tsx,json}",
      "!build",
      "!d",
      "!config*",
      "!node_modules",
      "!src/locales"
    ]
  },
  "formatter": {
    "lineWidth": 80,
    "indentWidth": 2,
    "indentStyle": "space",
    "includes": ["bin/**", "src/**", "!src/locales/**", "!config/**"]
  },
  "javascript": {
    "globals": ["global"],
    "formatter": {
      "trailingCommas": "es5",
      "arrowParentheses": "asNeeded",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "recommended": true
    }
  }
}
